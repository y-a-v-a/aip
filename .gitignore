# Secrets & runtime data — keep everything in data/ out of git EXCEPT the
# protective .htaccess (users.json, api_key, recipes/, lockout.json, api_log.jsonl).
data/*
!data/.htaccess

# Environment / secrets
.env
*.env

# Claude Code personal settings
.claude/settings.local.json

# Local data snapshots from tools/backup.sh (contain PIN hashes + recipes)
/backups/

# OS cruft
.DS_Store

# E2E test artifacts
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/
