# Apache protection for shared hosting (and any Apache deploy).
# NOTE: the PHP built-in server (Docker dev) ignores this and uses router.php.
#
# Never serve raw data/config files as static downloads, wherever installed.
<FilesMatch "\.(json|txt|md|lock|ini|key)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

DirectoryIndex index.php
